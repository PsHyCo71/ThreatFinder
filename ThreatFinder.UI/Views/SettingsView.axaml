<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:ThreatFinder.UI"
             xmlns:vm="using:ThreatFinder.ViewModels"
             x:Class="ThreatFinder.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <!-- Converter used to control the caret visibility while editing an API key. -->
        <converters:BoolToCaretBrushConverter x:Key="BoolToCaretBrushConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Changes the TextBox background when it receives keyboard focus. -->
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="LightBlue" />
        </Style>

        <!-- Changes the TextBox background when the pointer is over it. -->
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="LightBlue" />
        </Style>
    </UserControl.Styles>

    <Grid>

        <!-- Returns the user to the scan view. -->
        <Button HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                Padding="8"
                Background="Transparent"
                BorderThickness="0"
                FontSize="28"
                Command="{Binding GoToScanCommand}">

            <Button.Template>
                <ControlTemplate>
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>

            <Image Source="../Assets/settings-icon.png"
                   Width="40"
                   Height="40" />
        </Button>

        <!-- Toggles the application's theme between Light and Dark mode. -->
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding ToggleThemeCommand}">

            <Button.Template>
                <ControlTemplate>
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>

            <Image Source="../Assets/theme-icon.png"
                   Width="60"
                   Height="60"/>
        </Button>

        <!-- Main container for the API key settings. -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="400">

            <!-- Page title. -->
            <TextBlock Text="AUTH-KEYS"
                       FontSize="40"
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       Margin="0,100,0,30" />

            <!-- MalwareBazaar API key settings. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">

                <TextBlock Text="MalwareBazaar:"
                           Foreground="Black"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <!-- Allows long API keys to be displayed and edited without affecting the layout. -->
                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center">

                    <TextBox x:Name="MalwareBazaarTextBox"
                             Text="{Binding MalwareBazaarKey}"
                             IsReadOnly="{Binding !IsEditingMalwareBazaarKey}"
                             CaretBrush="{Binding IsEditingMalwareBazaarKey, Converter={StaticResource BoolToCaretBrushConverter}}"
                             Width="250"
                             CornerRadius="25"
                             Foreground="Black"
                             FontSize="18"
                             Background="LightBlue"
                             BorderBrush="Blue"
                             BorderThickness="2"
                             VerticalAlignment="Center">

                        <!-- Allows the API key to be saved by pressing Enter. -->
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter"
                                        Command="{Binding SaveKeyCommand}"
                                        CommandParameter="MalwareBazaar" />
                        </TextBox.KeyBindings>

                    </TextBox>

                </ScrollViewer>

                <Grid>
                    <!-- Enables editing of the MalwareBazaar API key. -->
                    <Button Content="+"
                            Command="{Binding OpenEditCommand}"
                            CommandParameter="MalwareBazaar"
                            IsVisible="{Binding !IsEditingMalwareBazaarKey}"
                            Width="36"
                            CornerRadius="25"
                            HorizontalContentAlignment="Center" />

                    <!-- Saves the modified MalwareBazaar API key. -->
                    <Button Content="✓"
                            Command="{Binding SaveKeyCommand}"
                            CommandParameter="MalwareBazaar"
                            IsVisible="{Binding IsEditingMalwareBazaarKey}"
                            Width="36"
                            CornerRadius="25"
                            HorizontalContentAlignment="Center" />
                </Grid>

            </StackPanel>

            <!-- URLhaus API key settings. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <TextBlock Text="URLhaus:"
                           Foreground="Black"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <TextBox x:Name="URLhausTextBox"
                         Text="{Binding UrlhausKey}"
                         IsReadOnly="{Binding !IsEditingUrlhausKey}"
                         CaretBrush="{Binding IsEditingUrlhausKey, Converter={StaticResource BoolToCaretBrushConverter}}"
                         Width="250"
                         CornerRadius="25"
                         Foreground="Black"
                         FontSize="18"
                         Background="LightBlue"
                         BorderBrush="Blue"
                         BorderThickness="2"
                         VerticalAlignment="Center">

                    <!-- Allows the API key to be saved by pressing Enter. -->
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter"
                                    Command="{Binding SaveKeyCommand}"
                                    CommandParameter="URLhaus" />
                    </TextBox.KeyBindings>

                </TextBox>

                <Grid>
                    <!-- Enables editing of the URLhaus API key. -->
                    <Button Content="+"
                            Command="{Binding OpenEditCommand}"
                            CommandParameter="URLhaus"
                            IsVisible="{Binding !IsEditingUrlhausKey}"
                            Width="36"
                            CornerRadius="25"
                            HorizontalContentAlignment="Center" />

                    <!-- Saves the modified URLhaus API key. -->
                    <Button Content="✓"
                            Command="{Binding SaveKeyCommand}"
                            CommandParameter="URLhaus"
                            IsVisible="{Binding IsEditingUrlhausKey}"
                            Width="36"
                            CornerRadius="25"
                            HorizontalContentAlignment="Center" />
                </Grid>

            </StackPanel>

            <!-- Displays an error message when provided by the view model. -->
            <TextBlock Margin="0,50"
                       Foreground="Red"
                       FontSize="20"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Text="{Binding ErrorMessage}" />

        </StackPanel>

    </Grid>

</UserControl>