<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThreatFinder.ViewModels"
             xmlns:converters="using:ThreatFinder.UI"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
             x:Class="ThreatFinder.Views.ScanView"
             x:DataType="vm:ScanViewModel">

    <UserControl.Resources>
        <!-- Converter used to compare the selected scan mode with a specific enum value. -->
        <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />

        <!-- Converter used to change the file information text color when an error occurs. -->
        <converters:BoolToErrorColorConverter x:Key="BoolToErrorColorConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Changes the TextBox background when it receives keyboard focus. -->
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="LightBlue" />
        </Style>

        <!-- Changes the TextBox background when the pointer is over it. -->
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="LightBlue" />
        </Style>
    </UserControl.Styles>

    <Grid>

        <!-- Opens the application settings. -->
        <Button HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                Padding="8"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding GoToSettingsCommand}">

            <Button.Template>
                <ControlTemplate>
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>

            <Image Source="../Assets/settings-icon.png"
                   Width="40"
                   Height="40" />
        </Button>
        
        <!-- TogToggles the application's theme between Light and Dark mode. -->
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding ToggleThemeCommand}">

            <Button.Template>
                <ControlTemplate>
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
                </ControlTemplate>
            </Button.Template>

            <Image Source="../Assets/theme-icon.png"
                   Width="60"
                   Height="60"/>
        </Button>

        <!-- Main scan controls. -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Buttons used to select the scan mode. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Margin="0,0,20,0"
                        Padding="20,10"
                        FontSize="16"
                        CornerRadius="25"
                        Command="{Binding SelectModeCommand}"
                        CommandParameter="{x:Static vm:ScanViewModel+ScanMode.Url}">
                    URL
                </Button>

                <Button Margin="20,0,0,0"
                        Padding="20,10"
                        FontSize="16"
                        CornerRadius="25"
                        Command="{Binding SelectModeCommand}"
                        CommandParameter="{x:Static vm:ScanViewModel+ScanMode.File}">
                    FILE
                </Button>

            </StackPanel>

            <!-- Text input used when scanning a URL. -->
            <TextBox HorizontalAlignment="Center"
                     TextAlignment="Center"
                     Margin="0,30,0,0"
                     Width="400"
                     CornerRadius="25"
                     Foreground="Black"
                     CaretBrush="Black"
                     FontSize="18"
                     Background="LightBlue"
                     BorderBrush="Blue"
                     BorderThickness="2"
                     Text="{Binding UrlInput}"
                     IsVisible="{Binding SelectedMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:ScanViewModel+ScanMode.Url}}" />

            <!-- File selection area displayed when file scanning is selected. -->
            <Border HorizontalAlignment="Center"
                    Margin="0,30,0,0"
                    Width="400"
                    Height="50"
                    CornerRadius="25"
                    Background="LightBlue"
                    BorderBrush="Blue"
                    BorderThickness="2"
                    IsVisible="{Binding SelectedMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:ScanViewModel+ScanMode.File}}">

                <!-- Displays the selected file name and size. -->
                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center">

                    <TextBlock Text="{Binding FileDisplayInfo}"
                               Foreground="{Binding FileError, Converter={StaticResource BoolToErrorColorConverter}}"
                               FontSize="18"
                               TextWrapping="NoWrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="15,0" />

                </ScrollViewer>

                <!-- Opens the file picker when the file selection area is clicked. -->
                <i:Interaction.Behaviors>
                    <ia:EventTriggerBehavior EventName="PointerPressed">
                        <ia:InvokeCommandAction Command="{Binding PickFileCommand}" />
                    </ia:EventTriggerBehavior>
                </i:Interaction.Behaviors>
            </Border>

            <!-- Starts the scan using the selected scan mode and input. -->
            <Button Padding="20,10"
                    FontSize="16"
                    HorizontalAlignment="Center"
                    Margin="0,30,0,0"
                    CornerRadius="25"
                    Background="Red"
                    IsDefault="True"
                    Command="{Binding ScanCommand}">
                SCAN
            </Button>

            <!-- Displays an indeterminate progress bar while a scan is running. -->
            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding IsScanning}"
                         Width="200"
                         Height="4"
                         HorizontalAlignment="Center"
                         Margin="0,15,0,0" />

        </StackPanel>

    </Grid>

</UserControl>