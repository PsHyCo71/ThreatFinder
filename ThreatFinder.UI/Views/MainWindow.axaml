<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ThreatFinder.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="ThreatFinder.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Icon="../Assets/ThreatFinder_ico.ico"
        Title="ThreatFinder">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground" Color="#9BD7EB" />
                    <SolidColorBrush x:Key="RingBrush" Color="#4545FF" />
                    <SolidColorBrush x:Key="FooterText" Color="Black" />
                    <Color x:Key="GlowCenterBig">Blue</Color>
                    <Color x:Key="GlowCenter">#6495ED</Color>
                    <Color x:Key="GlowMid">Cyan</Color>
                    <Color x:Key="GlowEdge">Transparent</Color>
                    <x:Double x:Key="GlowEndOffset">1</x:Double>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="RingBrush" Color="#7B2CBF" />
                    <SolidColorBrush x:Key="FooterText" Color="White" />
                    <Color x:Key="GlowCenterBig">Purple</Color>
                    <Color x:Key="GlowCenter">#7B2CBF</Color>
                    <Color x:Key="GlowMid">#7B2CBF</Color>
                    <Color x:Key="GlowEdge">#007B2CBF</Color>
                    <x:Double x:Key="GlowEndOffset">0.7</x:Double>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Panel>
        <!-- Main background of the application. -->
        <Rectangle Fill="{DynamicResource AppBackground}" />

        <!-- Decorative concentric circles positioned in the top-right corner. -->
        <Ellipse Width="60" Height="60"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-30,-30,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="100" Height="100"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-50,-50,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="140" Height="140"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-70,-70,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="180" Height="180"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-90,-90,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="220" Height="220"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-110,-110,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="260" Height="260"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-130,-130,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="300" Height="300"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-150,-150,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="340" Height="340"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-170,-170,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="380" Height="380"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-190,-190,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="420" Height="420"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-210,-210,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <!-- Decorative concentric circles positioned on the left side. -->
        <Ellipse Width="60" Height="60"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-30,0,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="100" Height="100"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-50,0,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="140" Height="140"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-70,0,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="180" Height="180"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-90,0,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="220" Height="220"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-110,0,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="260" Height="260"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-130,0,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="300" Height="300"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-150,0,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="340" Height="340"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-170,0,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="380" Height="380"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-190,0,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="420" Height="420"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-210,0,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <!-- Decorative concentric circles positioned along the bottom. -->
        <Ellipse Width="40" Height="40"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="500,0,0,-20"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="70" Height="70"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="500,0,0,-35"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="100" Height="100"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="500,0,0,-50"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="130" Height="130"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="500,0,0,-65"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="160" Height="160"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="500,0,0,-80"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="190" Height="190"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="500,0,0,-95"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="220" Height="220"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="500,0,0,-110"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="250" Height="250"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="500,0,0,-125"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="280" Height="280"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="500,0,0,-140"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="310" Height="310"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="500,0,0,-155"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <!-- Decorative concentric circles positioned along the top. -->
        <Ellipse Width="40" Height="40"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="-800,-20,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="70" Height="70"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="-800,-35,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="100" Height="100"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="-800,-50,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="130" Height="130"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="-800,-65,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="160" Height="160"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="-800,-80,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="190" Height="190"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="-800,-95,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="220" Height="220"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="-800,-110,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="250" Height="250"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="-800,-125,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="280" Height="280"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="-800,-140,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="310" Height="310"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="-800,-155,0,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <!-- Decorative concentric circles positioned on the right side. -->
        <Ellipse Width="40" Height="40"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,200,-20,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="70" Height="70"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,200,-35,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="100" Height="100"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,200,-50,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="130" Height="130"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,200,-65,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="160" Height="160"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,200,-80,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <Ellipse Width="190" Height="190"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,200,-95,0"
                 Fill="Transparent" Stroke="{DynamicResource RingBrush}" StrokeThickness="3" Opacity="0.4" />

        <!-- Large radial gradient used as the main central background effect. -->
        <Ellipse Width="1200"
                 Height="1200"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource GlowCenterBig}" Offset="0" />
                    <GradientStop Color="{DynamicResource GlowMid}" Offset="0.5" />
                    <GradientStop Color="{DynamicResource GlowEdge}" Offset="{DynamicResource GlowEndOffset}" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Radial gradient used as a decorative effect in the bottom-right corner. -->
        <Ellipse Width="400"
                 Height="400"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-120,-170">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource GlowCenter}" Offset="0" />
                    <GradientStop Color="{DynamicResource GlowMid}" Offset="0.5" />
                    <GradientStop Color="{DynamicResource GlowEdge}" Offset="{DynamicResource GlowEndOffset}" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Radial gradient used as a decorative effect in the bottom-left corner. -->
        <Ellipse Width="400"
                 Height="400"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-120,0,0,-170">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource GlowCenter}" Offset="0" />
                    <GradientStop Color="{DynamicResource GlowMid}" Offset="0.5" />
                    <GradientStop Color="{DynamicResource GlowEdge}" Offset="{DynamicResource GlowEndOffset}" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Displays the view associated with the current navigation state. -->
        <ContentControl Content="{Binding CurrentViewModel}" />

        <!-- Footer: anchored independently to the bottom of the Panel,
        so its height doesn't skew the control group's centering. -->
        <Grid VerticalAlignment="Bottom"
              ColumnDefinitions="*,*"
              Margin="20,0,20,20">

            <!-- Displays information about the services used by ThreatFinder. -->
            <StackPanel Grid.Column="0"
                        Orientation="Vertical"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom">

                <Image Source="../Assets/abuse.ch-icon.png"
                       Margin="0,0,20,0"
                       Height="30"/>

                <TextBlock FontSize="14"
                           Foreground="{DynamicResource FooterText}">

                    <Run Text="Powered by:&#10;MalwareBazaar &amp;&#10;URLhaus (" />

                    <InlineUIContainer BaselineAlignment="Baseline">
                        <HyperlinkButton Content="abuse.ch"
                                         NavigateUri="https://abuse.ch/"
                                         Padding="0"
                                         FontSize="14">
                            <HyperlinkButton.RenderTransform>
                                <TranslateTransform Y="3" />
                            </HyperlinkButton.RenderTransform>
                        </HyperlinkButton>
                    </InlineUIContainer>

                    <Run Text=")" />

                </TextBlock>

            </StackPanel>

            <!-- Provides links to the project's GitHub resources. -->
            <StackPanel Grid.Column="1"
                        Orientation="Vertical"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">

                <Image Source="../Assets/github-icon.png"
                       Height="30"
                       Width="30"/>

                <HyperlinkButton NavigateUri="https://github.com/PsHyCo71"
                                 Content="My GitHub Profile" />

                <HyperlinkButton NavigateUri="https://github.com/PsHyCo71/ThreatFinder"
                                 Content="Repository Page" />

            </StackPanel>

        </Grid>

    </Panel>

</Window>