<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:ThreatFinder.Core"
             xmlns:conv="using:ThreatFinder.UI"
             xmlns:vm="using:ThreatFinder.ViewModels"
             x:Class="ThreatFinder.Views.ResultsView"
             x:DataType="vm:ResultsViewModel">

    <UserControl.Resources>
        <!-- Converter used to display tag collections as comma-separated strings. -->
        <conv:StringListJoinConverter x:Key="StringListJoinConverter" />
    </UserControl.Resources>

    <Grid>

        <!-- Main container for the scan results. -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="400">

            <!-- Page title. -->
            <TextBlock Text="SCAN RESULTS"
                       FontSize="40"
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30" />

            <!-- Displays the target that was scanned. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">

                <TextBlock Text="Target:"
                           Foreground="Black"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <!-- Displays the URL when the scan was performed on a URL. -->
                <TextBlock Text="{Binding Result.Target}"
                           IsVisible="{Binding !IsFileResult}"
                           Foreground="Black"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           MaxWidth="250"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Result.Target}"/>

                <!-- Displays the selected file information when the scan was performed on a file. -->
                <TextBlock Text="{Binding FileDisplayInfo}"
                           IsVisible="{Binding IsFileResult}"
                           Foreground="Black"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           MaxWidth="250"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding FileDisplayInfo}" />

            </StackPanel>

            <!-- Displays the results returned by the available providers. -->
            <ItemsControl ItemsSource="{Binding Result.Results}"
                          HorizontalAlignment="Center">

                <ItemsControl.DataTemplates>

                    <!-- Template used when a provider identifies the target as malicious. -->
                    <DataTemplate x:DataType="core:MaliciousResult">
                        <StackPanel Margin="0,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProviderName}" FontWeight="Bold" Foreground="Black" FontSize="22" TextAlignment="Center"/>
                            <TextBlock Text="{Binding ThreatType, StringFormat='Threat Type: {0}'}" Foreground="#B60000" FontSize="20" TextAlignment="Center"/>
                            <TextBlock Text="{Binding Timestamp, StringFormat='Timestamp: {0}'}" Foreground="Black" FontSize="18" TextAlignment="Center"/>
                            <TextBlock Text="{Binding Tags, StringFormat='Tags: {0}', Converter={StaticResource StringListJoinConverter}}"
                                       Foreground="White"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       MaxWidth="250"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Tags, Converter={StaticResource StringListJoinConverter}}"/>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Template used when a provider does not identify the target as malicious. -->
                    <DataTemplate x:DataType="core:CleanResult">
                        <StackPanel Margin="0,5" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ProviderName}" FontWeight="Bold" Foreground="Black" FontSize="22" TextAlignment="Center"/>
                            <TextBlock Text="{Binding Message}" Foreground="Lime" FontSize="20" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Template used when an error occurs while processing a provider result. -->
                    <DataTemplate x:DataType="core:ErrorResult">
                        <StackPanel Margin="0,5" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ProviderName}" FontWeight="Bold" Foreground="Black" FontSize="22" TextAlignment="Center"/>
                            <TextBlock Text="{Binding Message}" Foreground="White" FontSize="20" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>

                </ItemsControl.DataTemplates>

            </ItemsControl>

            <!-- Returns the user to the scan view. -->
            <Button Padding="20,10"
                    FontSize="16"
                    HorizontalAlignment="Center"
                    Margin="0,30,0,0"
                    CornerRadius="25"
                    Background="Gray"
                    Command="{Binding GoToScanCommand}">
                EXIT
            </Button>

        </StackPanel>

    </Grid>

</UserControl>