<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ThreatFinder.ViewModels"
             x:Class="ThreatFinder.Views.ResultsView"
             x:DataType="vm:ResultsViewModel">

    <Grid>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="400">

            <TextBlock Text="SCAN RESULTS"
                       FontSize="40"
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       Margin="0,100,0,30" />

            <!-- <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">

                <TextBlock Text="Target:"
                           Foreground="Black"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <TextBox x:Name="MalwareBazaarTextBox"
                         Text="{Binding MalwareBazaarKey}"
                         IsReadOnly="{Binding !IsEditingMalwareBazaarKey}"
                         CaretBrush="{Binding IsEditingMalwareBazaarKey, Converter={StaticResource BoolToCaretBrushConverter}}"
                         Width="250"
                         CornerRadius="25"
                         Foreground="Black"
                         FontSize="18"
                         Background="LightBlue"
                         BorderBrush="Blue"
                         BorderThickness="2"
                         VerticalAlignment="Center">

                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter"
                                    Command="{Binding SaveKeyCommand}"
                                    CommandParameter="MalwareBazaar" />
                    </TextBox.KeyBindings>

                </TextBox>

                <Grid>
                    <Button Content="+"
                            Command="{Binding OpenEditCommand}"
                            CommandParameter="MalwareBazaar"
                            IsVisible="{Binding !IsEditingMalwareBazaarKey}"
                            Width="36"
                            CornerRadius="25"
                            HorizontalContentAlignment="Center" />

                    <Button Content="✓"
                            Command="{Binding SaveKeyCommand}"
                            CommandParameter="MalwareBazaar"
                            IsVisible="{Binding IsEditingMalwareBazaarKey}"
                            Width="36"
                            CornerRadius="25"
                            HorizontalContentAlignment="Center" />
                </Grid>

            </StackPanel>

            <!- <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <TextBlock Text="URLhaus:"
                           Foreground="Black"
                           FontSize="20"
                           VerticalAlignment="Center"
