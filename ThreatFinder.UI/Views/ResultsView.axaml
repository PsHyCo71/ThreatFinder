                    </TextBox.KeyBindings>

                </TextBox>

                <Grid>
                    <Button Content="+"
                            Command="{Binding OpenEditCommand}"
                            CommandParameter="URLhaus"
                            IsVisible="{Binding !IsEditingUrlhausKey}"
                            Width="36"
                            CornerRadius="25"
                            HorizontalContentAlignment="Center" />

                    <Button Content="✓"
                            Command="{Binding SaveKeyCommand}"
                            CommandParameter="URLhaus"
                            IsVisible="{Binding IsEditingUrlhausKey}"
                            Width="36"
                            CornerRadius="25"
                            HorizontalContentAlignment="Center" />
                </Grid>

            </StackPanel>

            <TextBlock Margin="0,50"
